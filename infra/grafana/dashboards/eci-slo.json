{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""}
  ],
  "annotations": {"list": []},
  "description": "ECI SLO Dashboard — availability, latency, auth, ingest",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["eci", "slo"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "ECI SLO Dashboard",
  "uid": "eci-slo-001",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability (5m)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.990},
              {"color": "green", "value": 0.995}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(eci_requests_total{outcome!~\"error\"}[5m])) / sum(rate(eci_requests_total[5m]))",
          "legendFormat": "Availability"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 Latency",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.4},
              {"color": "red", "value": 0.5}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(eci_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p99 Latency",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1.0},
              {"color": "red", "value": 1.5}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(eci_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Auth Denies / min",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 20}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(eci_auth_denied_total[1m])) * 60",
          "legendFormat": "denies/min"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Rate by Outcome",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "options": {"tooltip": {"mode": "multi"}},
      "fieldConfig": {
        "defaults": {"unit": "reqps", "custom": {"lineWidth": 2}}
      },
      "targets": [
        {
          "expr": "sum(rate(eci_requests_total{outcome!~\"error\"}[1m])) by (route)",
          "legendFormat": "{{route}} ok"
        },
        {
          "expr": "sum(rate(eci_requests_total{outcome=\"error\"}[1m])) by (route)",
          "legendFormat": "{{route}} error"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency Percentiles (p50 / p95 / p99)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "options": {"tooltip": {"mode": "multi"}},
      "fieldConfig": {
        "defaults": {"unit": "s", "custom": {"lineWidth": 2}}
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(eci_request_latency_seconds_bucket[2m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(eci_request_latency_seconds_bucket[2m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(eci_request_latency_seconds_bucket[2m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ingest Throughput",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
      "options": {"tooltip": {"mode": "multi"}},
      "fieldConfig": {
        "defaults": {"unit": "ops", "custom": {"lineWidth": 2}}
      },
      "targets": [
        {
          "expr": "sum(rate(eci_ingest_total[1m])) by (source_kind, outcome)",
          "legendFormat": "{{source_kind}} {{outcome}}"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Auth Deny Events by Reason",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 6},
      "options": {"tooltip": {"mode": "multi"}},
      "fieldConfig": {
        "defaults": {"unit": "short", "custom": {"lineWidth": 2}}
      },
      "targets": [
        {
          "expr": "sum(rate(eci_auth_denied_total[1m])) by (reason) * 60",
          "legendFormat": "{{reason}}"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    }
  ]
}
