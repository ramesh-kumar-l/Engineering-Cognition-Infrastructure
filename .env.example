# Copy to .env and fill in. Never commit .env.
# Canonical API image/module names are `eci-api` / `eci_api`.
# Legacy Docker compatibility: local builds also tag `docker-ingestion-api`.

# --- runtime env ---
ECI_ENV=local              # local | dev | prod
ECI_LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR
ECI_SERVICE_NAME=eci-api

# --- observability ---
# Leave OTLP unset to use console exporter (local dev).
# ECI_OTLP_ENDPOINT=http://localhost:4317
ECI_PROMETHEUS_PORT=9464

# Leave Langfuse unset to no-op.
# ECI_LANGFUSE_HOST=https://cloud.langfuse.com
# ECI_LANGFUSE_PUBLIC_KEY=
# ECI_LANGFUSE_SECRET_KEY=

# --- storage (Phase 2) ---
# Used by apps/api and packages/storage. Required from Phase 2 onward.
ECI_DB_URL=postgresql+psycopg://eci:eci@localhost:5432/eci
# For integration tests:
ECI_TEST_DB_URL=postgresql+psycopg://eci:eci@localhost:5432/eci_test

# --- production docker compose ---
# Required by `infra/docker/docker-compose.prod.yml`.
POSTGRES_PASSWORD=change-me
ECI_JWT_SECRET=replace-with-32-char-random-secret
GRAFANA_ADMIN_PASSWORD=change-me

# Optional production overrides.
# ECI_BLOB_BACKEND=local
# ECI_BLOB_S3_BUCKET=
# ECI_BLOB_S3_REGION=us-east-1
# IMAGE_TAG=latest
# GITHUB_REPOSITORY_OWNER=eci
# ECI_API_PORT=8000
# ECI_PROMETHEUS_HOST_PORT=9090
# ECI_ALERTMANAGER_PORT=9093
# ECI_GRAFANA_PORT=3000

# --- ingestion (Phase 2) ---
ECI_BLOB_ROOT=./data/blobs        # local blob root; switch to S3 in prod via ADR
ECI_INGEST_MAX_BYTES=10485760     # 10 MiB per source
